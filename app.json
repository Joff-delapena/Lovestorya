{
  "expo": {
    "name": "LoveStorya",
    "slug": "lovestorya",
    "scheme": "lovestorya",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jofferson11.lovestorya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FDF6F0"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/lovestorya-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FDF6F0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dd5898d5-e55a-4c88-b1f0-b3398464444d"
      }
    },
    "owner": "jofferson11"
  }
}
